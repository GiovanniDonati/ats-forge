{
  "name": "ats-cv-generator",
  "version": "2.0.0",
  "description": "ATS-friendly resume generator (DOCX + Markdown) — Clean Architecture, TypeScript template",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "setup": "cp resume.example.json resume.json",
    "clean": "rimraf dist"
  },
  "keywords": [
    "resume",
    "cv",
    "ats",
    "generator",
    "typescript",
    "clean-architecture"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "docx": "^9.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.39",
    "prisma": "^7.8.0",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
