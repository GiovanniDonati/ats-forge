generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LanguageLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  FLUENT
  NATIVE
}

enum EducationType {
  HIGH_SCHOOL
  TECHNICAL
  BACHELOR
  TECHNOLOGIST
  POSTGRADUATE
  MASTER
  DOCTORATE
  OTHER
}

model User {
  id          String       @id @default(uuid())
  username    String       @unique
  email       String       @unique
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  displayName String       @map("display_name")
  avatarUrl   String?      @default("https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y") @map("avatar_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  accounts    Account[]
  credentials Credential[]
  profiles    Profile[]
}

model Account {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String    @map("provider_account_id")
  accessToken       String?   @map("access_token")
  refreshToken      String?   @map("refresh_token")
  tokenType         String?   @map("token_type")
  scope             String?   @map("scope")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([provider, providerAccountId], map: "provider_providerAccountId_idx")
}

model Credential {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}

model Profile {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Multiplos perfis/currículos por usuário
  resumeName String @default("Meu Currículo") @map("resume_name")

  name     String
  headline String?
  summary  String?
  email    String?
  phone    String?
  location String?

  linkedin  String?
  github    String?
  portfolio String?

  languages   ProfileLanguage[]
  skills      Skill[]           @relation("ProfileToSkill")
  experiences Experience[]
  educations  Education[]
  projects    Project[]
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[] @relation("ProfileToSkill")
  projects Project[] @relation("ProjectToSkill")
}

model ProfileLanguage {
  id        String        @id @default(uuid())
  profileId String        @map("profile_id")
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  level     LanguageLevel @default(BASIC)

  @@unique([profileId, name])
}

model Experience {
  id         String    @id @default(uuid())
  profileId  String    @map("profile_id")
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title      String
  company    String
  location   String?
  activities String[]
  results    String[]
  stacks     String[]
  startDate  DateTime  @map("start_date")
  endDate    DateTime? @map("end_date")
  isCurrent  Boolean   @default(false) @map("is_current")
}

model Education {
  id           String        @id @default(uuid())
  profileId    String        @map("profile_id")
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school       String
  fieldOfStudy String
  degreeType   EducationType @map("degree_type")
  startDate    DateTime      @map("start_date")
  endDate      DateTime?     @map("end_date")
  isCurrent    Boolean       @default(false) @map("is_current")
}

model Project {
  id          String    @id @default(uuid())
  profileId   String    @map("profile_id")
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String?
  repository  String?
  deploy      String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  skills      Skill[]   @relation("ProjectToSkill")
}
